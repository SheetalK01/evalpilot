{
  "name": "evalpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Test, red-team and monitor AI apps. Test your AI before your users do.",
  "author": "Sheetal Khadanga <khadangasheetal@gmail.com>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.17"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @evalpilot/shared",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "test:coverage": "npm run build:packages && npm run test:coverage --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset:test": "bash scripts/reset-test-db.sh",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "test:int": "npm run build:packages && npm run test:int --workspaces --if-present",
    "deps:check": "npm ls --all > /dev/null"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,prisma}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  }
}
