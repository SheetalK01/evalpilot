{
  "name": "@evalpilot/worker",
  "version": "0.1.0",
  "private": true,
  "description": "EvalPilot background worker: test runs, red-team runs and target pings (BullMQ)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@evalpilot/server-core": "0.1.0",
    "@evalpilot/shared": "0.1.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "ts-jest": "29.4.15",
    "tsc-watch": "7.2.1"
  }
}
