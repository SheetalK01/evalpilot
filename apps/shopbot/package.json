{
  "name": "@evalpilot/shopbot",
  "version": "0.1.0",
  "private": true,
  "description": "ShopBot: the demo customer-support chatbot for ShopSphere that EvalPilot tests, red-teams and traces",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@evalpilot/sdk": "0.1.0",
    "@evalpilot/shared": "0.1.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "tsc-watch": "7.2.1",
    "vitest": "4.1.12"
  }
}
