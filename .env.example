# EvalPilot configuration. Copy to `.env` and fill in the values. `.env` is git-ignored.

NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SHOPBOT_PORT=4100
# Where the worker reaches ShopBot. Docker: http://shopbot:4100
SHOPBOT_URL=http://localhost:4100

# ── Database: the MySQL running on your machine ──────────────────────────────
# Without Docker:
DATABASE_URL="mysql://evalpilot:<password>@127.0.0.1:3306/evalpilot"
# With Docker, containers reach the host's MySQL through host.docker.internal:
# DATABASE_URL="mysql://evalpilot:<password>@host.docker.internal:3306/evalpilot"
# Integration/E2E tests. The database name must end with _test (it is emptied on every run).
TEST_DATABASE_URL="mysql://evalpilot:<password>@127.0.0.1:3306/evalpilot_test"
# Optional: only needed for `npm run db:migrate` (schema changes) when your MySQL user
# cannot create databases. Create it once: CREATE DATABASE evalpilot_shadow; + GRANT.
# SHADOW_DATABASE_URL="mysql://evalpilot:<password>@127.0.0.1:3306/evalpilot_shadow"

# ── Redis: the Redis running on your machine ─────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# With Docker: REDIS_URL=redis://host.docker.internal:6379

# ── Security ─────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=<random-64-hex-chars>
# 32 random bytes, base64: openssl rand -base64 32
TARGET_SECRET_KEY=<32-byte-base64>
# Allow targets on localhost/private IPs (needed for ShopBot in development). Use false in production.
ALLOW_PRIVATE_TARGETS=true

# ── AI ───────────────────────────────────────────────────────────────────────
# mock = deterministic and free (tests, CI, demos). live = real Claude calls.
AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── GitHub OAuth (optional; the button only shows when both are set) ─────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── SDK / CLI (ShopBot sends traces with this key; create one in Settings) ───
EVALPILOT_API_KEY=
EVALPILOT_URL=http://localhost:4000

# ── Docker (docker compose up) ───────────────────────────────────────────────
# Containers reach the host's MySQL/Redis through host.docker.internal; 127.0.0.1/localhost URLs
# above are rewritten for them automatically. Your MySQL user must accept connections from
# Docker (e.g. 'evalpilot'@'%'), and MySQL must listen beyond 127.0.0.1 on Linux.
# Secure session cookie (default: on in production). docker-compose sets it to false for http://localhost.
# COOKIE_SECURE=
