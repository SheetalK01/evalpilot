{
  "name": "@evalpilot/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared zod schemas, types and pure evaluators for EvalPilot",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "tsup": "8.5.1",
    "vitest": "4.1.12"
  }
}
